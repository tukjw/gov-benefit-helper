# docker-compose.local.yml이 읽는 변수. 루트 .env로 복사해 바꿀 값만 주석을 푼다. .env는 커밋하지 않는다.
# 모두 기본값이 있어 .env 없이도 뜬다.
#MYSQL_ROOT_PASSWORD=root
# 포트를 바꾸면 backend/.env의 DB_PORT도 같은 값으로 맞춘다.
#MYSQL_PORT=3306
# 다른 기기에서도 접속하려면 0.0.0.0
#MYSQL_BIND=127.0.0.1
# 바꾸면 backend/.env에도 같은 값을 적는다.
#DB_NAME=gov_benefit
#DB_USER=gov_benefit_user
#DB_PASSWORD=gov_benefit_user
