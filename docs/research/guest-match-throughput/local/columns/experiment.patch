@@ -0,0 +1,18 @@
+package kr.govbenefit.match.service;
+
+import java.time.LocalDateTime;
+import kr.govbenefit.benefit.domain.ApplyPeriodType;
+import kr.govbenefit.benefit.dto.BenefitSummary;
+import kr.govbenefit.common.api.ApiTimes;
+
+/** (실험, 커밋하지 않음) 조건 비교 목록이 benefit에서 읽는 컬럼만 담은 행. */
+public record BenefitListRow(String serviceId, String name, String purposeSummary, String agencyName,
+                             String agencyType, String agencyCode, String serviceField, String userType,
+                             String applyPeriodText, ApplyPeriodType applyPeriodType, Boolean applyPeriodNeedsReview,
+                             LocalDateTime lastSeenAt) {
+
+    BenefitSummary summary() {
+        return new BenefitSummary(serviceId, name, purposeSummary, agencyName, agencyType, serviceField,
+                applyPeriodText, applyPeriodType, applyPeriodNeedsReview, ApiTimes.toOffset(lastSeenAt));
+    }
+}
