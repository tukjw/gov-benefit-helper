# app VM의 /opt/gov-benefit/app/app.env로 복사해 채운다(권한 600). 저장소에 커밋하지 않는다.
# 값의 의미는 backend/src/main/resources/application.yaml.

# db VM의 내부 주소(vmbr1). 계정은 db VM의 .env와 같게 한다.
DB_HOST=10.10.0.12
DB_PORT=3306
DB_NAME=gov_benefit
DB_USER=gov_benefit
DB_PASSWORD=

# 액세스 토큰 서명 키. base64, 32바이트 이상. 예: openssl rand -base64 32
JWT_SECRET=

# 공공데이터포털 Decoding 키
GOV24_SERVICE_KEY=

# 계정 메일(결정 0047). 발신 도메인 인증과 IAM 사용자는 docs/ops/mail-domain.md
MAIL_SENDER=ses
# 발송 권한(ses:SendEmail)만 가진 IAM 사용자의 접근 키
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-northeast-2
SES_FROM="정부 혜택 도우미 <help@mail.govbenefit.kr>"
