          "expr": "(sum by (uri) (rate(http_server_requests_seconds_count{job=\"app\", uri!~\"/actuator.*\", outcome=\"SERVER_ERROR\"}[5m])) or 0 * sum by (uri) (rate(http_server_requests_seconds_count{job=\"app\", uri!~\"/actuator.*\"}[5m]))) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"app\", uri!~\"/actuator.*\"}[5m]))",
