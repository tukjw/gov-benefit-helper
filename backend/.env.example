# backend/.env로 복사해 바꿀 값만 주석을 푼다. .env는 커밋하지 않는다.
# application.yaml이 작업 디렉터리의 .env를 읽으므로 ./gradlew는 backend/에서 실행한다.
# 빈 값(DB_USER=)은 빈 문자열로 적용되어 기본값을 덮으므로, 쓰지 않을 항목은 주석으로 둔다.
#DB_HOST=localhost
# 루트 .env의 MYSQL_PORT를 바꿨다면 같은 값으로 맞춘다.
#DB_PORT=3306
#DB_NAME=gov_benefit
# local 프로필은 주석으로 두면 docker-compose.local.yml의 로컬 계정을 쓴다. 그 외 환경에서는 필수.
#DB_USER=
#DB_PASSWORD=
# 공공서비스(혜택) API 인증키(공공데이터포털 Decoding 키). 수집을 실행할 때만 필요하다.
#GOV24_SERVICE_KEY=
