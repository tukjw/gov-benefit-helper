# backend/.env로 복사해 바꿀 값만 주석을 푼다. .env는 커밋하지 않는다.
# application.yaml이 작업 디렉터리의 .env를 읽으므로 ./gradlew는 backend/에서 실행한다.
# 빈 값(DB_USER=)은 빈 문자열로 적용되어 기본값을 덮으므로, 쓰지 않을 항목은 주석으로 둔다.
#DB_HOST=localhost
# 루트 .env의 MYSQL_PORT를 바꿨다면 같은 값으로 맞춘다.
#DB_PORT=3306
#DB_NAME=gov_benefit
# local 프로필은 주석으로 두면 docker-compose.local.yml의 로컬 계정을 쓴다. 그 외 환경에서는 필수.
#DB_USER=
#DB_PASSWORD=
# 공공서비스(혜택) API 인증키(공공데이터포털 Decoding 키). 수집을 실행할 때만 필요하다.
#GOV24_SERVICE_KEY=
# 액세스 토큰 서명 키(base64, 32바이트 이상). 만들기: openssl rand -base64 32
# local 프로필은 주석으로 두면 기동할 때 임의 키를 만든다(재시작하면 로그인이 풀린다). 그 외 환경에서는 필수.
#JWT_SECRET=
# 메일 발송 구현(결정 0032). resend면 아래 두 값이 필수다. local 프로필은 이 값과 관계없이 로그로만 남긴다.
#MAIL_SENDER=
# Resend API 키(발송 권한만 준 키). 발신 도메인 인증 절차는 docs/ops/mail-domain.md
#RESEND_API_KEY=
# 발신 주소. 인증한 도메인의 주소여야 한다. 예: 정부 혜택 도우미 <no-reply@govbenefit.kr>
#RESEND_FROM=
